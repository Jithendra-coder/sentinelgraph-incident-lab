# Demo Mode. Prometheus metrics are optional; other incident sources remain fixtures.
SENTINELGRAPH_DB=data/sentinelgraph.sqlite3
LOG_LEVEL=INFO
# Optional read-only Prometheus instant query. Install with: pip install -e ".[telemetry]"
# SENTINELGRAPH_PROMETHEUS_URL=http://localhost:9090
# SENTINELGRAPH_PROMETHEUS_QUERY=up
# SENTINELGRAPH_PROMETHEUS_TOKEN=
# Optional advisory-only OpenAI analysis. Set OPENAI_API_KEY through your shell or secret manager.
# SENTINELGRAPH_ANALYSIS_PROVIDER=openai
# SENTINELGRAPH_OPENAI_MODEL=gpt-6.1-sol
# OPENAI_API_KEY=
